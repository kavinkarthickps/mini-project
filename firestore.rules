rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles: users can only read and write their own profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) &&
        isValidId(userId) &&
        incoming().userId == request.auth.uid &&
        incoming().email is string &&
        incoming().email.size() <= 180;
      allow update: if isOwner(userId) &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'preferredLanguage', 'defaultCrop', 'updatedAt']);
      allow delete: if false;
    }

    // Fields: farm plots owned by the user
    match /fields/{fieldId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(fieldId) &&
        incoming().userId == request.auth.uid &&
        incoming().fieldName is string &&
        incoming().fieldName.size() <= 100 &&
        incoming().crop is string &&
        incoming().crop.size() <= 50;
      allow update: if isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fieldName', 'crop', 'cropVariety', 'growthStage', 'acreage',
          'location', 'notes', 'riskScore', 'riskTier', 'lastInspected', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Scan reports: diagnostic reports owned by user
    match /scans/{scanId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(scanId) &&
        incoming().userId == request.auth.uid &&
        incoming().cropType is string &&
        incoming().pestName is string;
      allow update: if isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'fieldName', 'fieldId', 'notes', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }

    // Monitoring tasks: actionable tasks
    match /tasks/{taskId} {
      allow get: if isSignedIn() && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() &&
        isValidId(taskId) &&
        incoming().userId == request.auth.uid &&
        incoming().title is string &&
        incoming().title.size() <= 150;
      allow update: if isSignedIn() &&
        existing().userId == request.auth.uid &&
        incoming().userId == existing().userId &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'completed', 'title', 'description', 'dueDate', 'priority', 'updatedAt'
        ]);
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
